# =============================================================================
# SOPM - Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_WORKERS=4
API_CORS_ORIGINS=["http://localhost:3000"]

# ---------------------------------------------------------------------------
# Security / JWT
# ---------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sopm
POSTGRES_USER=sopm
POSTGRES_PASSWORD=CHANGE_ME_strong_password
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Sync URL for Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_strong_password
REDIS_DB=0
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# Queue settings
QUEUE_DEFAULT_TIMEOUT=300
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY=60
QUEUE_DLQ_NAME=sopm:dlq

# ---------------------------------------------------------------------------
# MinIO
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME_access_key
MINIO_SECRET_KEY=CHANGE_ME_secret_key
MINIO_SECURE=false
MINIO_BUCKET_ARTIFACTS=sopm-artifacts
MINIO_BUCKET_PACKAGES=sopm-packages

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_HEARTBEAT_INTERVAL=30
WORKER_SHUTDOWN_TIMEOUT=60
WORKER_QUEUE_POLL_INTERVAL=1
WORKER_ID=

# ---------------------------------------------------------------------------
# Sandbox (Kubernetes)
# ---------------------------------------------------------------------------
SANDBOX_ENABLED=true
SANDBOX_NAMESPACE=sopm-sandbox
SANDBOX_RUNTIME_CLASS=gvisor
SANDBOX_IMAGE=sopm/runner:latest
SANDBOX_IMAGE_PULL_POLICY=IfNotPresent
SANDBOX_DEFAULT_TIMEOUT=300
SANDBOX_MAX_TIMEOUT=3600
SANDBOX_CPU_REQUEST=100m
SANDBOX_CPU_LIMIT=500m
SANDBOX_MEMORY_REQUEST=128Mi
SANDBOX_MEMORY_LIMIT=512Mi
SANDBOX_SERVICE_ACCOUNT=sopm-runner

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=sopm-api
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production

PROMETHEUS_METRICS_PATH=/metrics
LOG_LEVEL=INFO
LOG_FORMAT=json

# Loki (push logs via structured logging)
LOKI_URL=http://localhost:3100

# ---------------------------------------------------------------------------
# Scheduling
# ---------------------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL=30
SCHEDULER_MAX_MISSED_RUNS=3

# ---------------------------------------------------------------------------
# Platform limits
# ---------------------------------------------------------------------------
MAX_FUNCTION_SIZE_BYTES=10485760   # 10 MB
MAX_PAYLOAD_SIZE_BYTES=1048576     # 1 MB
MAX_EXECUTION_TIMEOUT=3600         # 1 hour
MAX_FUNCTIONS_PER_USER=100
MAX_VERSIONS_PER_FUNCTION=50
