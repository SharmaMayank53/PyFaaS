# =============================================================================
# SOPM Sandbox Runner
#
# Minimal image that runs inside the gVisor Kubernetes Job.
# Only contains what's needed to download and execute user code.
# =============================================================================

FROM python:3.12-slim

# Security: nobody user (uid 65534)
# This matches the Kubernetes securityContext
RUN groupadd --gid 65534 nobody-sopm || true && \
    usermod --shell /sbin/nologin nobody || true

WORKDIR /runner

# Install minimal runtime deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install only what the runner needs
RUN pip install --no-cache-dir \
    minio==7.2.7 \
    requests==2.32.3 \
    httpx==0.27.0

# Copy runner script
COPY sandbox/runner.py /runner/runner.py

# Make /work and /tmp writable for nobody
RUN mkdir -p /work /tmp && \
    chown 65534:65534 /work /tmp

USER 65534

# Work directory is mounted as emptyDir in K8s
WORKDIR /work

ENTRYPOINT ["python", "/runner/runner.py"]
